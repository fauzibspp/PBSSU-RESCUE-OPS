{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "eslint/no-unused-vars": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", ".cache/**"]
}
